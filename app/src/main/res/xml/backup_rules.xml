<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules (API <= 30).

   Everything in the sandbox is backed up EXCEPT the Screen Pulse vault: screen
   frames must never leave the handset, not via cloud backup and not via
   device-to-device transfer. See data_extraction_rules.xml for API 31+.
-->
<full-backup-content>
    <include domain="root" path="." />
    <include domain="file" path="." />
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="external" path="." />

    <exclude domain="root" path=".screenpulse" />
    <exclude domain="file" path=".screenpulse" />
    <exclude domain="external" path=".screenpulse" />
</full-backup-content>
